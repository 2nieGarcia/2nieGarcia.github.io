---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/home/Chrome';
import Cover from '../../components/Cover.astro';
import { AREA_LABEL } from '../../lib/expand';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order || b.data.pushedAt.localeCompare(a.data.pushedAt),
  );
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, total: all.length, prev: all[i - 1], next: all[i + 1] },
  }));
}

type Props = { project: CollectionEntry<'projects'>; index: number; total: number; prev?: CollectionEntry<'projects'>; next?: CollectionEntry<'projects'> };
const { project, index, total, prev, next } = Astro.props as Props;
const { title, tagline, area, stack, note, demo, repo, screenshots } = project.data;
const { Content } = await render(project);
const [cover, ...shots] = screenshots;
const pad = (n: number) => String(n).padStart(2, '0');

// "01-entry-point.png" -> "entry point"
const caption = (url: string) =>
  decodeURIComponent(url.split('/').pop()!).replace(/\.\w+$/, '').replace(/^\d+[-_]?/, '').replace(/[-_]+/g, ' ');
---

<Base title={`${title} | Antonio B. Garcia Jr.`} description={tagline ?? title}>
  <Chrome client:only="react" />
  <main class="pj">
    <nav class="pj-crumb" aria-label="Breadcrumb">
      <a class="cursor-target" href="/#work">← antonio.sys / projects</a>
      <span>{pad(index + 1)} / {pad(total)}</span>
    </nav>

    <header class="pj-head">
      <h1>{title}</h1>
      {tagline && <p class="pj-lede">{tagline}</p>}
      <ul class="pj-tags">
        <li class="pj-area">{AREA_LABEL[area] ?? area}</li>
        {stack.map((s) => <li>{s}</li>)}
      </ul>
      {note && <p class="pj-note">{note}</p>}
      <p class="pj-links">
        <a class="pj-btn cursor-target" href={repo}>Source code ↗</a>
        {demo && <a class="pj-btn pj-btn-ghost cursor-target" href={demo}>Live demo ↗</a>}
      </p>
    </header>

    <figure class="pj-cover">
      {cover ? <Image src={cover} inferSize alt={`${title}: ${caption(cover)}`} widths={[800, 1400]} sizes="(max-width: 72rem) 100vw, 72rem" loading="eager" /> : <Cover seed={project.id} />}
    </figure>

    <article class="pj-body"><Content /></article>

    {
      shots.length > 0 && (
        <section class="pj-shots" aria-label="Screenshots">
          {shots.map((src, i) => (
            <figure>
              <Image src={src} inferSize alt={`${title}: ${caption(src)}`} widths={[640, 1200]} sizes="(max-width: 72rem) 100vw, 36rem" />
              <figcaption><span>FIG. {pad(i + 2)}</span> {caption(src)}</figcaption>
            </figure>
          ))}
        </section>
      )
    }

    <nav class="pj-next" aria-label="More projects">
      {prev ? <a class="cursor-target" href={`/projects/${prev.id}/`}><span>← previous</span>{prev.data.title}</a> : <span />}
      {next ? <a class="cursor-target pj-next-r" href={`/projects/${next.id}/`}><span>next →</span>{next.data.title}</a> : <a class="cursor-target pj-next-r" href="/#work"><span>back →</span>All projects</a>}
    </nav>
  </main>
</Base>

<style>
  .pj { position: relative; z-index: 1; max-width: 72rem; margin: 0 auto; padding: 0 var(--gutter) 6rem; }
  .pj-crumb { display: flex; justify-content: space-between; align-items: center; padding: 2rem 0 3rem; font: 0.8rem var(--mono); color: var(--muted); }
  .pj-crumb a { color: var(--fg); text-decoration: none; }
  .pj-crumb a:hover { color: var(--accent); }
  .pj-crumb span { color: var(--accent); }

  .pj-head { max-width: 52rem; margin-bottom: 2.5rem; }
  h1 { font: var(--display-weight) clamp(2.2rem, 6vw, 4.6rem) / 1 var(--display); text-transform: uppercase; letter-spacing: -0.01em; margin: 0 0 1.25rem; text-wrap: balance; }
  .pj-lede { font-size: clamp(1.1rem, 1.8vw, 1.35rem); color: var(--muted); margin: 0 0 1.5rem; max-width: 44rem; }
  .pj-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0 0 1.25rem; }
  .pj-tags li { font: 0.75rem var(--mono); border: 1px solid var(--line); padding: 0.2rem 0.65rem; color: var(--fg); background: rgb(7 9 11 / 0.6); }
  .pj-tags .pj-area { color: var(--bg); background: var(--accent); border-color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; }
  .pj-note { font: 600 0.95rem var(--mono); color: var(--accent); margin: 0 0 1.75rem; }
  .pj-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; }
  .pj-btn { display: inline-block; clip-path: var(--notch); background: var(--accent); color: var(--bg); text-decoration: none; padding: 0.8rem 1.3rem; font: var(--display-weight) 0.85rem var(--display); letter-spacing: 0.12em; text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .pj-btn:hover { background: var(--fg); }
  .pj-btn-ghost { background: rgb(7 9 11 / 0.85); color: var(--fg); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 55%, var(--line)); }
  .pj-btn-ghost:hover { background: var(--accent); color: var(--bg); }

  .pj-cover { margin: 0 0 3.5rem; clip-path: var(--notch); box-shadow: inset 0 0 0 1px var(--line); background: var(--surface); }
  .pj-cover :global(img), .pj-cover :global(.cover) { display: block; width: 100%; height: auto; max-height: 72svh; object-fit: cover; object-position: top left; }

  .pj-body { max-width: 46rem; font-size: 1.08rem; line-height: 1.7; }
  .pj-body :global(h2), .pj-body :global(h3) { font: var(--display-weight) 1.4rem/1.2 var(--display); text-transform: uppercase; letter-spacing: 0.02em; margin: 2.5rem 0 0.75rem; }
  .pj-body :global(h2)::before, .pj-body :global(h3)::before { content: '// '; color: var(--accent); }
  .pj-body :global(p), .pj-body :global(li) { color: color-mix(in oklab, var(--fg) 88%, var(--muted)); }
  .pj-body :global(strong) { color: var(--fg); }
  .pj-body :global(code) { font: 0.9em var(--mono); color: var(--accent); }
  .pj-body :global(ul) { padding-left: 1.2rem; }
  .pj-body :global(li::marker) { color: var(--accent); }

  .pj-shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr)); gap: 2rem; margin: 4rem 0; }
  .pj-shots figure { margin: 0; }
  .pj-shots :global(img) { display: block; width: 100%; height: auto; clip-path: var(--notch); background: var(--surface); }
  figcaption { font: 0.78rem var(--mono); color: var(--muted); margin-top: 0.6rem; }
  figcaption span { color: var(--accent); }

  .pj-next { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 5rem; background: var(--line); box-shadow: 0 0 0 1px var(--line); }
  .pj-next a { display: grid; gap: 0.3rem; padding: 1.4rem 1.5rem; background: var(--bg); color: var(--fg); text-decoration: none; font: var(--display-weight) 1.1rem/1.2 var(--display); text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .pj-next a span { font: 0.72rem var(--mono); color: var(--accent); text-transform: none; }
  .pj-next a:hover { background: var(--accent); color: var(--bg); }
  .pj-next a:hover span { color: var(--bg); }
  .pj-next-r { text-align: right; justify-items: end; }
  .pj-next > span { background: var(--bg); }
</style>
