---
// The longer story behind the home page quote, for people who clicked through. Text: src/content/about/philosophy.md.
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chrome from '../components/home/Chrome';
import fallenAngel from '../assets/art/fallen-angel.jpg';

const entry = (await getEntry('about', 'philosophy'))!;
const { Content } = await render(entry);
const art = (await getImage({ src: fallenAngel, width: 1600, format: 'webp' })).src;
---

<Base title="My story | Antonio B. Garcia Jr." description="The longer (and less serious) version of Antonio B. Garcia Jr.: how I got into code, how I work, and what I do off the clock.">
  <Chrome client:only="react" />
  <main class="bio">
    <nav class="bio-crumb" aria-label="Breadcrumb">
      <a class="cursor-target" href="/#philosophy">← antonio.sys / about</a>
      <span>bio.txt</span>
    </nav>

    <header class="bio-head">
      <p class="bio-kicker">Antonio B. Garcia Jr. · AI/ML engineer · PM</p>
      <h1>{entry.data.title}</h1>
    </header>

    <figure class="bio-art">
      <div class="bio-frame"><img src={art} alt="Alexandre Cabanel, The Fallen Angel (1847): the angel glares over his folded arm." loading="eager" /></div>
      <figcaption><span>FIG. 01</span> Alexandre Cabanel, The Fallen Angel, 1847</figcaption>
    </figure>

    <article class="bio-body"><Content /></article>

    <nav class="bio-next" aria-label="Back">
      <a class="cursor-target" href="/#work"><span>see the work →</span>Things I've built</a>
    </nav>
  </main>
</Base>

<style>
  .bio { position: relative; z-index: 1; max-width: 72rem; margin: 0 auto; padding: 0 var(--gutter) 6rem; }
  .bio-crumb { display: flex; justify-content: space-between; align-items: center; padding: 2rem 0 3rem; font: 0.8rem var(--mono); color: var(--muted); }
  .bio-crumb a { color: var(--fg); text-decoration: none; }
  .bio-crumb a:hover { color: var(--accent); }
  .bio-crumb span { color: var(--accent); }

  .bio-head { margin-bottom: 2.5rem; }
  .bio-kicker { font: 0.8rem var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin: 0 0 1rem; }
  h1 { font: var(--display-weight) clamp(2.6rem, 8vw, 6rem) / 0.95 var(--display); text-transform: uppercase; letter-spacing: -0.01em; margin: 0; }

  /* same coral duotone as the home page reveal, pushed in on the eye (33.75% 33%, see .rv-art) */
  .bio-art { margin: 0 0 3.5rem; }
  .bio-frame { overflow: hidden; clip-path: var(--notch); }
  .bio-art img { display: block; width: 100%; height: clamp(14rem, 40svh, 26rem); object-fit: cover; object-position: 33.75% 33%; transform: scale(2.4); transform-origin: 33.75% 33%; filter: grayscale(1) contrast(1.15) brightness(0.75) sepia(1) hue-rotate(-30deg) saturate(2.2); }
  .bio-art figcaption { font: 0.78rem var(--mono); color: var(--muted); margin-top: 0.6rem; }
  .bio-art figcaption span { color: var(--accent); }

  .bio-body { max-width: 46rem; font-size: 1.12rem; line-height: 1.75; }
  .bio-body > :global(p:first-child) { font: var(--display-weight) clamp(1.3rem, 2.4vw, 1.7rem) / 1.3 var(--display); color: var(--accent); }
  .bio-body :global(h2) { font: var(--display-weight) 1.4rem/1.2 var(--display); text-transform: uppercase; letter-spacing: 0.02em; margin: 3rem 0 0.75rem; }
  .bio-body :global(h2)::before { content: '// '; color: var(--accent); }
  .bio-body :global(p) { color: color-mix(in oklab, var(--fg) 88%, var(--muted)); }
  .bio-body :global(ul) { list-style: none; padding: 0; margin: 1rem 0 0; border-top: 1px solid var(--line); }
  .bio-body :global(li) { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; padding: 0.65rem 0; border-bottom: 1px solid var(--line); color: color-mix(in oklab, var(--fg) 88%, var(--muted)); }
  .bio-body :global(li strong) { font: 500 0.8rem/1.9 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  @media (max-width: 520px) { .bio-body :global(li) { grid-template-columns: 1fr; gap: 0.1rem; } }
  .bio-body :global(blockquote) { margin: 1.5rem 0; padding: 0.25rem 0 0.25rem 1.5rem; border-left: 2px solid var(--accent); }
  .bio-body :global(blockquote p) { font: var(--display-weight) clamp(1.3rem, 2.6vw, 1.9rem) / 1.2 var(--display); text-transform: uppercase; color: var(--fg); margin: 0 0 0.75rem; }
  .bio-body :global(blockquote p + p) { font: 500 0.8rem/1.4 var(--mono); letter-spacing: 0.08em; text-transform: none; color: var(--muted); }

  .bio-next { margin-top: 5rem; box-shadow: 0 0 0 1px var(--line); }
  .bio-next a { display: grid; gap: 0.3rem; justify-items: end; text-align: right; padding: 1.4rem 1.5rem; background: var(--bg); color: var(--fg); text-decoration: none; font: var(--display-weight) 1.1rem/1.2 var(--display); text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .bio-next a span { font: 0.72rem var(--mono); color: var(--accent); text-transform: none; }
  .bio-next a:hover { background: var(--accent); color: var(--bg); }
  .bio-next a:hover span { color: var(--bg); }
</style>
